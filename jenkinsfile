pipeline{
agent any
stages
{
stage('Build')
{
steps{
echo "Running automation tests....."
bat "python -m pip install -r requirements.txt"
}
}
stage('Test')
{
steps{
echo "Testing the code...."
bat "python -m pytest --alluredir=./Reports"
}
}

stage('Deploy')
{
steps{
echo "Deploying the project......"
}
}
}
}
